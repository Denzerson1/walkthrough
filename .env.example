# Copy to .env and fill in. Never commit .env (brief §2.3).

# --- Editor auth (M0+) -------------------------------------------------------
# Single shared password protecting /edit/:projectId. No user accounts in the MVP.
EDITOR_PASSWORD=change-me
# Random string used to sign the editor session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/walkthrough.db
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Storage (M0: local disk. M10: S3-compatible / Cloudflare R2) -----------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data
# Only needed when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- AI assistant (M5) -------------------------------------------------------
# Required from M5 onward. The API fails with an explicit error if missing.
ANTHROPIC_API_KEY=
# Default per docs/SPEC.md §2. Escalation if eval pass rate < 85%: claude-opus-5
ASSISTANT_MODEL=claude-haiku-4-5-20251001
ASSISTANT_MAX_TOKENS=1024
# Cost guard: max assistant requests per session per hour.
ASSISTANT_RATE_LIMIT_PER_HOUR=60

# --- Uploads (M4) ------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760

# --- Web ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Capture pipeline (WSL2, docs/PIPELINE.md) -------------------------------
# Read from the environment of the shell that runs `pipeline train`, not from
# this file. Defaults match scripts/setup_pipeline_wsl.sh; set only to move them.
# GSPLAT_PYTHON=/root/.venvs/gsplat/bin/python
# GSPLAT_EXAMPLES=/root/gsplat/examples
